rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }
    function isOwner() {
      return signedIn() && roleOf(request.auth.uid) == 'owner';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.username == resource.data.username
      );
    }

    // Produk: semua user bisa baca; kasir hanya boleh mengubah field "stock" (stok sisa hitung fisik)
    match /products/{id} {
      allow read: if signedIn();
      allow create, delete: if isOwner();
      allow update: if isOwner() || (
        signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
      );
    }

    match /product_costs/{id} {
      allow read, write: if isOwner();
    }

    // Laporan: ID = tanggal. Kasir hanya boleh CREATE; owner yang baca/ubah/hapus.
    match /daily_closings/{date} {
      allow create: if signedIn()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.date == date;
      allow read, update, delete: if isOwner();
    }

    match /owner_withdrawals/{id} {
      allow read, write: if isOwner();
    }
  }
}
